# Copy to backend/.env and fill in. Never commit the real file.

# --- FACEIT Data API (required for player stats and Match Scout) ---
# Server-side API key: https://developers.faceit.com -> App Studio -> your app -> API keys (Server side)
FACEIT_API_KEY=
FACEIT_REQUESTS_PER_SECOND=4

# --- Public URL of the app (OAuth/OpenID return URLs, Secure cookies when https://) ---
APP_BASE_URL=http://localhost:8000

# --- Sign in with Steam: works without any secret (OpenID 2.0). Optional Web API key unused for login. ---
# STEAM_WEB_API_KEY=

# --- Sign in with FACEIT (FACEIT Connect, OAuth2 + PKCE). Create an app in FACEIT Developers, set the
# redirect URI to  ${APP_BASE_URL}/api/auth/faceit/callback  and paste the client credentials here.
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=

# Session lifetime
SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=72

MAX_DEMO_UPLOAD_MB=1024
# Test-only login shortcut (localhost only). Keep false.
AUTH_DEV_LOGIN=false

# --- Private beta ---
# Players, Match Scout, demos and maps require a signed-in user. Keep true.
REQUIRE_LOGIN=true
# Optional: who may sign in, comma-separated SteamID64 / FACEIT player id / FACEIT nickname. Empty = anyone.
# BETA_ALLOWLIST=76561198000000000,my_faceit_nick
# Real Elo snapshots of linked accounts every N minutes (one cached request per player, pauses on 429). 0 = off.
TRACKING_INTERVAL_MINUTES=180
# Pending predictions are compared with finished matches every N minutes. 0 = off.
PREDICTION_CHECK_MINUTES=20

# --- Storage ---
# Where the database, API cache and uploaded demos live. The Windows launcher defaults to
# %LOCALAPPDATA%\FaceitIntelligence\data (outside the repo, survives git pull / rebuilds). Set only to override.
# DATA_DIR=
